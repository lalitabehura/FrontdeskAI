# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=production
APP_NAME=Frontdesk AI

# Your domain (DNS A record must point at the server)
APP_DOMAIN=app.example.com
FRONTEND_URL=https://app.example.com
ALLOWED_HOSTS=["app.example.com","localhost","127.0.0.1"]
CORS_ORIGINS=["https://app.example.com"]

# python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# BACK THIS UP: without it, encrypted data (chat history) cannot be read.
ENCRYPTION_KEY=
# python3 -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Your own email: gets the Platform admin console (MRR, all businesses, trial extensions)
PLATFORM_ADMIN_EMAILS=you@example.com

# AI (recommended). Without it the assistant uses built-in rules + your FAQs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe billing: create 3 monthly Prices in the Stripe dashboard and paste their IDs.
# Webhook endpoint: https://app.example.com/api/v1/billing/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
TRIAL_DAYS=14

# Email (Postmark, Amazon SES, SendGrid, Mailgun…): confirmations, reminders, birthday wishes, resets
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@example.com
